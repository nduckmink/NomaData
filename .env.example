# ============================================================
# NomaData — environment configuration (copy to .env)
# ============================================================
# The LLM never receives credentials. Secrets stay here and are
# injected into connectors/providers at the API composition root.
#
# This file feeds BOTH Docker Compose (${VAR} interpolation for the infra
# services) AND the app config. Every value has a safe default in
# docker-compose.yml, so `pnpm infra` / `pnpm up` work even with no .env.

# ---------- Infra credentials & ports (Docker Compose) ----------
# Postgres + Cube container credentials. Change these for anything real.
POSTGRES_USER=nomadata
POSTGRES_PASSWORD=nomadata
POSTGRES_DB=nomadata
# Published host ports (container-internal ports stay 5432/4000/8000/3000).
POSTGRES_PORT=5432
CUBE_PORT=4000
API_PORT=8000
WEB_PORT=3000
# Secret Cube signs its API tokens with — change in any shared/real environment.
CUBE_API_SECRET=dev-secret-change-me
# NOTE: Postgres applies POSTGRES_* only on FIRST init (empty data volume).
# If you change these after the DB already exists, wipe it: `pnpm infra:reset`.

# ---------- API ----------
# NOMADATA_ENV also controls CORS: in "development" the API accepts ANY
# localhost/127.0.0.1 port (so it still works when Next.js falls back to :3001
# because :3000 is taken). In any other value it enforces NOMADATA_CORS_ORIGINS.
NOMADATA_ENV=development
NOMADATA_API_HOST=0.0.0.0
NOMADATA_API_PORT=8000
NOMADATA_LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the web app).
# Only enforced when NOMADATA_ENV != development — set this for production.
NOMADATA_CORS_ORIGINS=http://localhost:3000

# ---------- Application metadata database ----------
# Postgres used by NomaData itself (semantic artifacts, connections, etc.).
# Used when running the API locally (pnpm api:dev). In Docker, the API derives
# this URL from POSTGRES_* above — if you change those, keep this in sync.
NOMADATA_DATABASE_URL=postgresql://nomadata:nomadata@localhost:5432/nomadata

# ---------- Cube (semantic/query layer) ----------
NOMADATA_CUBE_URL=http://localhost:4000

# ---------- AI provider (interface only in M0 — not called yet) ----------
# OpenAI-compatible endpoint. Model-agnostic: swap provider via config only.
NOMADATA_AI_PROVIDER=openai_compatible
NOMADATA_AI_BASE_URL=https://api.openai.com/v1
NOMADATA_AI_API_KEY=
NOMADATA_AI_MODEL=gpt-4o-mini

# ---------- Web client ----------
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
