# Cube (semantic/query layer) — copy to cube/.env for standalone runs.
# In Docker Compose these are provided by the compose file instead.
CUBEJS_DEV_MODE=true
CUBEJS_DB_TYPE=postgres
CUBEJS_DB_HOST=localhost
CUBEJS_DB_NAME=nomadata
CUBEJS_DB_USER=nomadata
CUBEJS_DB_PASS=nomadata
CUBEJS_API_SECRET=dev-secret-change-me
